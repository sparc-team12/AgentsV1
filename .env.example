# Local-dev environment overrides. Copy this file to `.env` (same folder,
# repo root) and fill in real values. `.env` is loaded by src/app/config.py
# via python-dotenv (requirements-dev.txt) and is git-ignored — never commit
# real secrets. The deployed Lambda ignores this file entirely; its
# environment comes from template.yaml / CloudFormation instead.

# --- Chat Agent prose rewording (optional; unset = deterministic text only) ---
# One of: bedrock, gemini. Leave unset to disable LLM rewording entirely.
PHRASING_BACKEND=

# Google AI Studio (used when PHRASING_BACKEND=gemini).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.5-flash

# Amazon Bedrock (used when PHRASING_BACKEND=bedrock). Uses your normal AWS
# credential chain (aws configure / env vars) — no key goes in this file.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0

# --- App-wide (rarely needed locally; sensible defaults already apply) ---
# APP_TODAY=2026-09-18
# SESSION_SECRET=dev-only-not-a-secret
